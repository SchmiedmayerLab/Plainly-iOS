    "HEALTHKIT_PERMISSIONS_DESCRIPTION" : {
      "comment" : "A description of the health data that the app will access.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plainly uses clinical health records stored on your device and accessed via HealthKit to provide context during the conversation.\n\nWhen participating in a study, you should grant Plainly **full access** to your clinical records; otherwise the study will not have sufficient context, and your participation cannot be evaluated consistently with participants who have granted full access.\n\nPlainly does not access any other health data outside of the conversation."
          }
        }
      }
    },
    "HEALTHKIT_PERMISSIONS_SKIP_BUTTON" : {
      "comment" : "Recovery button that lets the participant finish onboarding if the HealthKit authorization flow does not return.",
