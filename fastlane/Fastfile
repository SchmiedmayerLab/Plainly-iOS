require "fileutils"

default_platform(:ios)

APP_CONFIG = {
  default_environment: "staging",
  default_app_identifier: "edu.stanford.llmonfhir",
  default_version_name: "0.1.0",
  default_release_notes: "Bug fixes and performance improvements.",
  scheme: "Plainly",
  plist_path: "Plainly/Supporting Files/Info.plist"
}.freeze

SCREENSHOTS_DIRECTORY = File.expand_path("screenshots", __dir__).freeze

def installed_provisioning_profile(app_identifier)
  profile_directories = [
    File.expand_path("~/Library/Developer/Xcode/UserData/Provisioning Profiles"),
    File.expand_path("~/Library/MobileDevice/Provisioning Profiles")
  ]
  profile_paths = profile_directories.flat_map do |directory|
    Dir.glob(File.join(directory, "*.{mobileprovision,provisionprofile}"))
  end
  matching_profiles = profile_paths.select do |path|
    FastlaneCore::ProvisioningProfile.bundle_id(path) == app_identifier
  end
  UI.user_error!("No installed provisioning profile found for #{app_identifier}") if matching_profiles.empty?

  profile_path = matching_profiles.max_by { |path| File.mtime(path) }
  FastlaneCore::ProvisioningProfile.uuid(profile_path)
end

platform :ios do
  before_all do
    ENV["FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT"] = "120"
    ENV["FASTLANE_XCODEBUILD_SETTINGS_RETRIES"] = "4"
  end

  desc "Screenshots"
  lane :screenshots do
    FileUtils.rm_rf(File.expand_path("~/Library/Caches/tools.fastlane/screenshots"))
    FileUtils.rm_f(Dir.glob(File.join(SCREENSHOTS_DIRECTORY, "**/*.{png,jpg,jpeg}")))

    run_tests(
      destination: "generic/platform=iOS Simulator",
      configuration: "Debug",
      derived_data_path: ".derivedData",
      xcargs: [
        "-skipPackagePluginValidation",
        "-skipMacroValidation"
      ],
      build_for_testing: true
    )
    
    snapshot(
      test_without_building: true,
      derived_data_path: ".derivedData",
      xcargs: "-collect-test-diagnostics never",
      devices: [
        "iPhone 17 Pro Max",
        "iPad Pro 13-inch (M5)"
      ],
      languages: [
         "en-US",
      ],
      scheme: APP_CONFIG[:scheme],
      output_directory: SCREENSHOTS_DIRECTORY,
      clear_previous_screenshots: true,
      concurrent_simulators: false,
      override_status_bar: true,
      override_status_bar_arguments: "--time 9:41 --dataNetwork wifi --wifiMode active --wifiBars 3 --cellularMode active --operatorName '' --cellularBars 4 --batteryState discharging --batteryLevel 100",
      only_testing: [
        "PlainlyUITests/AppStoreScreenshotTests/testScreenshots"
      ],
      stop_after_first_error: true,
      skip_open_summary: true,
      # AppStoreScreenshotTests provides the project's custom screenshot implementation.
      skip_helper_version_check: true
    )

    Dir.glob(File.join(SCREENSHOTS_DIRECTORY, "**/*.png")).each do |file|
      jpeg_file = file.sub(/\.png\z/, ".jpg")
      sh("sips", "-s", "format", "jpeg", "-s", "formatOptions", "100", file, "--out", jpeg_file, log: false)
      File.delete(file)
    end

    expected_sizes = {
      "iPhone 17 Pro Max" => [1320, 2868],
      "iPad Pro 13-inch (M5)" => [2752, 2064]
    }
    expected_sizes.each do |device, expected_size|
      files = Dir.glob(File.join(SCREENSHOTS_DIRECTORY, "**/#{device}-*.jpg"))
      UI.user_error!("Expected three screenshots for #{device}, found #{files.count}") unless files.count == 3

      files.each do |file|
        properties = sh("sips", "-g", "pixelWidth", "-g", "pixelHeight", "-g", "hasAlpha", file, log: false)
        actual_size = [
          properties[/pixelWidth: (\d+)/, 1].to_i,
          properties[/pixelHeight: (\d+)/, 1].to_i
        ]
        UI.user_error!("Unexpected screenshot size for #{file}: #{actual_size.join('x')}") unless actual_size == expected_size
        UI.user_error!("Screenshot contains an alpha channel: #{file}") unless properties.include?("hasAlpha: no")
      end
    end
    generated_files = Dir.glob(File.join(SCREENSHOTS_DIRECTORY, "**/*.{jpg,jpeg,png}"))
    UI.user_error!("Expected six screenshots, found #{generated_files.count}") unless generated_files.count == 6
  end

  desc "Run the Firebase emulator end-to-end UI test"
  lane :firebase_uitest do
    result_bundle_path = File.expand_path("../Plainly-Firebase-E2E.xcresult", __dir__)
    FileUtils.rm_rf(result_bundle_path)

    run_tests(
      scheme: APP_CONFIG[:scheme],
      testplan: "Plainly Firebase End-to-End",
      derived_data_path: ".derivedData/firebase-e2e",
      devices: ["iPhone 17"],
      only_testing: [
        "PlainlyUITests/FirebaseEndToEndTests/testChatAndReportUploadThroughFirebaseEmulators",
        "PlainlyUITests/FirebaseEndToEndTests/testChatErrorThroughFirebaseEmulators",
        "PlainlyUITests/FirebaseEndToEndTests/testChatErrorAfterStreamStartsThroughFirebaseEmulators"
      ],
      concurrent_workers: 1,
      max_concurrent_simulators: 1,
      result_bundle: true,
      result_bundle_path: result_bundle_path,
      output_directory: ".",
      xcargs: [
        "-skipPackagePluginValidation",
        "-skipMacroValidation"
      ]
    )
  end

  desc "Archive app"
  lane :archive do |options|
    appidentifier = options[:appidentifier].to_s.strip.empty? ? APP_CONFIG[:default_app_identifier] : options[:appidentifier]
    provisioningProfile = options[:provisioningProfile].to_s.strip
    provisioningProfile = installed_provisioning_profile(appidentifier) if provisioningProfile.empty?
    
    update_app_identifier(
      plist_path: APP_CONFIG[:plist_path],
      app_identifier: appidentifier
    )

    build_app(
      scheme: APP_CONFIG[:scheme],
      derived_data_path: ".derivedData",
      skip_profile_detection: true,
      xcargs: [
        "-skipPackagePluginValidation",
        "-skipMacroValidation",
        "PROVISIONING_PROFILE_SPECIFIER=#{provisioningProfile}"
      ],
      export_options: {
        provisioningProfiles: {
          appidentifier => provisioningProfile
        }
      }
    )
  end

  desc "Publish a release to TestFlight or the App Store depending on the environment"
  lane :deploy do |options|
    environment = options[:environment].to_s.strip.empty? ? APP_CONFIG[:default_environment] : options[:environment]
    appidentifier = options[:appidentifier].to_s.strip.empty? ? APP_CONFIG[:default_app_identifier] : options[:appidentifier]
    provisioningProfile = options[:provisioningProfile].to_s.strip
    versionname = options[:versionname].to_s.strip.empty? ? APP_CONFIG[:default_version_name] : options[:versionname]
    releasenotes = options[:releasenotes].to_s.strip.empty? ? APP_CONFIG[:default_release_notes] : options[:releasenotes]

    UI.message("Using environment: #{environment}")
    UI.message("Using app identifier: #{appidentifier}")
    UI.message("Using provisioning profile: #{provisioningProfile.empty? ? 'automatically detected' : provisioningProfile}")
    UI.message("Using version name: #{versionname}")
    UI.message("Using release notes: #{releasenotes}")

    releasenotes = releasenotes.gsub('\u2019', "'")

    currentversion = get_version_number()
    UI.message("Current version: #{currentversion}")

    if Gem::Version.new(versionname) > Gem::Version.new(currentversion)
      increment_version_number(
        version_number: versionname
      )
      UI.message("Version bumped to #{versionname}.")
    else
      UI.message("No version bump needed. Current version (#{currentversion}) is greater than or equal to desired version (#{versionname}).")
    end

    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_BASE64"],
      is_key_content_base64: true
    )
    
    buildnumber = options[:buildnumber].to_s.strip
    if buildnumber.empty?
      latest_build_number = latest_testflight_build_number(
        app_identifier: appidentifier
      )
      buildnumber = latest_build_number + 1
      UI.message("No build number provided. Incrementing to #{buildnumber}.")
    else
      UI.message("Using provided build number: #{buildnumber}.")
    end
    increment_build_number(
      build_number: buildnumber
    )
    
    archive(
      appidentifier: appidentifier,
      provisioningProfile: provisioningProfile,
    )
    commit = last_git_commit

    if environment == "production"
      deliver(
        app_identifier: appidentifier,
        release_notes: {
          'en-US' => releasenotes
        },
        overwrite_screenshots: true,
        submit_for_review: true,
        force: true,
        reject_if_possible: true,
        automatic_release: true,
        precheck_include_in_app_purchases: false,
      )
    elsif environment == "spineai"
      upload_to_testflight(
        app_identifier: appidentifier,
        distribute_external: true,
        reject_build_waiting_for_review: true,
        groups: [
          "SpineAI"
        ],
        submit_beta_review: true,
        notify_external_testers: true,
        changelog: commit[:message]
      )
    else
      upload_to_testflight(
        app_identifier: appidentifier,
        distribute_external: true,
        reject_build_waiting_for_review: true,
        groups: [
          "External Testers"
        ],
        submit_beta_review: true,
        notify_external_testers: true,
        changelog: commit[:message]
      )
    end
  end
end
